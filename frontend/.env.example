# Confidential Salary Benchmarking Pool — frontend environment template
# Copy to .env.local and fill in. Vite exposes only VITE_* vars to the browser.

# ─────────────────────────────────────────────────────────────────────────────
# CANONICAL BROWSER NETWORK: PREVIEW.
#
# The browser/dApp flow targets the Preview public test network. Undeployed is
# the local devnet used by the Node tooling (CLI) only and must NOT be selected
# for the browser flow — it is exposed below purely as an optional override for
# advanced local testing.
# ─────────────────────────────────────────────────────────────────────────────

# Network for the browser wallet & dApp: preview (canonical/default) | preprod.
VITE_NETWORK=preview

# The deployed contract address on the selected network.
# Get it from: npm run deploy -- --network preview  (or read .midnight-state.json)
# Leave empty to deploy a fresh contract from the UI ("Deploy contract" button).
VITE_CONTRACT_ADDRESS=

# Midnight indexer used to read live on-chain contract state.
# Defaults to the wallet's configured indexer; these are the public Preview
# fallbacks and mirror frontend/src/lib/network.ts (the single source of truth).
VITE_INDEXER_URL=https://indexer.preview.midnight.network/api/v4/graphql
VITE_INDEXER_WS_URL=wss://indexer.preview.midnight.network/api/v4/graphql/ws

# Proving for the custom contract: the browser wallet cannot prove arbitrary
# custom circuits against a hosted proof server, so proving is delegated to the
# LOCAL Midnight proof server (docker compose proof-server, host port 6305; CORS
# enabled). This is required for both Preview and the devnet.
VITE_PROOF_SERVER_URL=http://127.0.0.1:6305

# ----------------------------------------------------------------------------
# OPTIONAL — LOCAL DEVNET (VITE_NETWORK=undeployed), CLI/devnet testing only.
#
# The `undeployed` network exists only while the docker-compose stack
# (node :9940, indexer :8085, proof server :6305) is running, and its browser
# use additionally requires the wallet extension to be switched into its
# "Undeployed" preset. It is NOT the default browser network.
#
#   VITE_NETWORK=undeployed
#   VITE_INDEXER_URL=http://127.0.0.1:8085/api/v4/graphql
#   VITE_INDEXER_WS_URL=ws://127.0.0.1:8085/api/v4/graphql/ws
#   VITE_PROOF_SERVER_URL=http://127.0.0.1:6305
# ----------------------------------------------------------------------------