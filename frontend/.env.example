# Confidential Salary Benchmarking Pool — frontend environment template
# Copy to .env.local and fill in. Vite exposes only VITE_* vars to the browser.

# Network to connect the wallet to: preview (default) | preprod | undeployed
VITE_NETWORK=preview

# The deployed contract address on the selected network.
# Get it from: npm run deploy -- --network preview  (or read .midnight-state.json)
# Leave empty to deploy a fresh contract from the UI ("Deploy contract" button).
VITE_CONTRACT_ADDRESS=

# Midnight indexer used to read live on-chain contract state.
# Defaults to the wallet's configured indexer; these are the public fallbacks.
VITE_INDEXER_URL=https://indexer.preview.midnight.network/api/v4/graphql
VITE_INDEXER_WS_URL=wss://indexer.preview.midnight.network/api/v4/graphql/ws

# ----------------------------------------------------------------------------
# Local devnet (VITE_NETWORK=undeployed) — run the browser dApp against the
# docker-compose stack (node :9940, indexer :8085, proof server :6305).
#
# VITE_PROOF_SERVER_URL switches proving from the wallet (which cannot prove
# custom contracts against a hosted proof server) to the local Midnight proof
# server. The browser can reach it directly (CORS is enabled).
#
#   VITE_NETWORK=undeployed
#   VITE_CONTRACT_ADDRESS=                      # deploy a fresh contract via the UI
#   VITE_INDEXER_URL=http://127.0.0.1:8085/api/v4/graphql
#   VITE_INDEXER_WS_URL=ws://127.0.0.1:8085/api/v4/graphql/ws
#   VITE_PROOF_SERVER_URL=http://127.0.0.1:6305
# ----------------------------------------------------------------------------