# ─────────────────────────────────────────────────────────────────────────────
# Node tooling environment (used by src/deploy.ts, src/cli.ts, src/e2e.ts)
#
# MIDNIGHT_WALLET_SEED  — wallet seed (hex, 64 chars) for public networks.
#                         On the local `undeployed` devnet the genesis seed is
#                         used automatically. NEVER commit a real seed.
#
# MIDNIGHT_INDEXER_URL       — override indexer HTTP GraphQL endpoint
# MIDNIGHT_INDEXER_WS_URL    — override indexer WebSocket endpoint
# MIDNIGHT_NODE_URL          — override Midnight node RPC endpoint
# MIDNIGHT_PROOF_SERVER_URL  — override proof server endpoint
# MIDNIGHT_FAUCET_URL        — override faucet URL
# PRIVATE_STATE_PASSWORD     — password protecting the level private-state DB
# ─────────────────────────────────────────────────────────────────────────────
MIDNIGHT_WALLET_SEED=
MIDNIGHT_INDEXER_URL=http://127.0.0.1:8085/api/v4/graphql
MIDNIGHT_INDEXER_WS_URL=ws://127.0.0.1:8085/api/v4/graphql/ws
MIDNIGHT_NODE_URL=ws://127.0.0.1:9940
MIDNIGHT_PROOF_SERVER_URL=http://127.0.0.1:6305
PRIVATE_STATE_PASSWORD=Local-Devnet-Development-Placeholder-1